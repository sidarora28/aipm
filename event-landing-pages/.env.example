# ---- Beehiiv (server-side only; never expose the API key to the client) ----
# Create an API key in Beehiiv: Settings > Integrations > API.
BEEHIIV_API_KEY=
# Publication ID, looks like: pub_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BEEHIIV_PUBLICATION_ID=

# ---- Analytics (optional, client-side) ----
# Mixpanel project token (matches the bwcc tracking stack).
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://example.com
