# ---- Beehiiv (server-side only; never expose the API key to the client) ----
# REQUIRED. Create an API key in Beehiiv: Settings > Integrations > API.
BEEHIIV_API_KEY=
# OPTIONAL. Defaults to JustAnotherPM (pub_f1be7747-60e4-4e55-8206-888ba2c12941)
# in lib/beehiiv.ts. Only set this to target a different publication.
BEEHIIV_PUBLICATION_ID=

# ---- Analytics (optional, client-side) ----
# Mixpanel project token (matches the bwcc tracking stack).
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://example.com
