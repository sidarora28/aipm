# Base64-encoded service-account JSON key (the whole file, one line).
#   cat service-account.json | base64 -w0
# Scopes needed on the service account: spreadsheets + drive.file
GOOGLE_SERVICE_ACCOUNT_B64=

# The roster spreadsheet. The "issued" ledger lives in the same spreadsheet.
SHEET_ID=
ROSTER_TAB=Sheet1
LEDGER_TAB=issued

# Drive folder the certificates are written to. Must be shared with the
# service account's client_email as Editor.
DRIVE_FOLDER_ID=

# Lookup rate limit, per IP.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60
